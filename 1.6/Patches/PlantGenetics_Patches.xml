<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Seed packets are worth more with better genetics. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/StatDef[defName="MarketValue"]/parts</xpath>
    <value>
      <li Class="AdvancedPlantGenetics.StatPart_SeedQuality"/>
    </value>
  </Operation>

  <!-- Bulk goods traders and settlements sell (and buy) heirloom seed. Each stack is one random heirloom strain. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="Caravan_Neolithic_BulkGoods" or defName="Caravan_Outlander_BulkGoods" or defName="Orbital_BulkGoods" or defName="Base_Neolithic_Standard" or defName="Base_Outlander_Standard"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef">
        <thingDef>APG_SeedPacket</thingDef>
        <countRange>4~12</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>APG_SeedPacket</thingDef>
        <countRange>4~12</countRange>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="Caravan_Outlander_Exotic" or defName="Orbital_Exotic"]/stockGenerators</xpath>
    <value>
      <li Class="StockGenerator_SingleDef">
        <thingDef>APG_SeedPacket</thingDef>
        <countRange>3~8</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>APG_CultureMedium</thingDef>
        <countRange>10~30</countRange>
      </li>
    </value>
  </Operation>
</Patch>
